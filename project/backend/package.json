{
  "name": "homestay-backend",
  "version": "1.0.0",
  "description": "NestJS Backend for Homestay Booking & TTLock Self Check-in Automation",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r ./register-paths.cjs dist/backend/src/main.js",
    "db:init:local": "ts-node -r tsconfig-paths/register src/migrations/init-local.ts",
    "db:customer-management": "node src/migrations/customer-management.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:admin": "ts-node -r tsconfig-paths/register src/modules/admin/test-admin-operations.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register src/migrations/db-cli.ts migrate",
    "db:seed": "ts-node -r tsconfig-paths/register src/migrations/db-cli.ts seed",
    "db:reset": "ts-node -r tsconfig-paths/register src/migrations/db-cli.ts reset",
    "db:verify": "ts-node -r tsconfig-paths/register src/migrations/db-cli.ts verify",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:customer": "node test/customer-accounts.cjs && node test/customer-management.cjs",
    "test:customer:mailpit": "node test/customer-e2e.cjs",
    "test:customer-management": "node test/customer-management.cjs",
    "test:customer-accounts": "node test/customer-accounts.cjs"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.11.2",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.3.7",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.3.7",
    "@payos/node": "^1.0.8",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.6.8",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.10",
    "handlebars": "^4.7.8",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
