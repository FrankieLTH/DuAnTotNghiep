# App Configuration
PORT=3000

# Database Configuration (MySQL, matching docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=homestay_local_password
DB_DATABASE=duantotnghiep

# Redis Configuration (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_homestay_jwt_key_2026

# TTLock Smart Lock Integration
TTLOCK_CLIENT_ID=your_ttlock_client_id
TTLOCK_CLIENT_SECRET=your_ttlock_client_secret
TTLOCK_CALLBACK_PATH=/webhooks/ttlock/callback

# PayOS Payment Gateway Integration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# SMTP Mailer Configuration (Gmail).
# Set SMTP_USER to your Gmail address and SMTP_PASS to a Google App Password.
# Alternative Gmail connection: SMTP_PORT=465, SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Doi Bong Gon" <your-email@gmail.com>
